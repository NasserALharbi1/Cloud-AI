Screen {
    background: #080b0a;
    color: #d7dedb;
}

#main-root {
    width: 100%;
    height: 100%;
    background: #080b0a;
}

/* ── Centered Start Screen (matches screenshot layout) ────────────────────── */
#start-hero {
    width: 100%;
    height: 1fr;
    align: center middle;
    content-align: center middle;
    background: #080b0a;
    padding: 1 2;
}

#hero-box {
    width: 72;
    height: auto;
    background: #080b0a;
    align: center middle;
    padding: 0;
}

#logo-art {
    width: 72;
    height: 11;
    text-align: center;
    content-align: center middle;
    margin-bottom: 1;
}

#spaced-title {
    width: 72;
    text-align: center;
    color: #5fd1a0;
    text-style: bold;
    margin-bottom: 1;
}

#subtitle-bold {
    width: 72;
    text-align: center;
    color: #e2e8f0;
    text-style: bold;
    margin-bottom: 1;
}

#hint-dim {
    width: 72;
    text-align: center;
    color: #7f8b87;
    margin-bottom: 1;
}

#hero-input-row {
    width: 66;
    height: 3;
    background: #0c1110;
    border-top: solid #1c2824;
    border-bottom: solid #1c2824;
    align: left middle;
    padding: 0 1;
    margin-bottom: 1;
}

#hero-input-row:focus-within {
    border-top: solid #3b6e5c;
    border-bottom: solid #3b6e5c;
    background: #0e1513;
}

#hero-prompt-symbol {
    width: 3;
    height: 1;
    color: #5fd1a0;
    text-style: bold;
}

#hero-prompt-input {
    width: 1fr;
    height: 1;
    background: transparent;
    border: none;
    color: #d7dedb;
    padding: 0;
}

#hero-prompt-input:focus {
    border: none;
    background: transparent;
}

#hero-counters-row {
    width: 66;
    height: 1;
    text-align: center;
    content-align: center middle;
    color: #7f8b87;
    margin-bottom: 1;
}

#hero-model-row {
    width: 72;
    height: 1;
    text-align: center;
    content-align: center middle;
    color: #7f8b87;
}

/* ── Chat View Chrome (hidden on start screen, shown after first message) ── */
#slim-header {
    width: 100%;
    height: 2;
    background: #0b0f0e;
    border-bottom: solid #1b2421;
    padding: 0 2;
    display: none;
}

#header-left {
    width: 1fr;
    height: 1;
    color: #d7dedb;
    content-align: left middle;
}

#header-right {
    width: auto;
    height: 1;
    color: #7f8b87;
    content-align: right middle;
    text-align: right;
}

#chat-scroll {
    width: 100%;
    height: 1fr;
    padding: 1 3;
    background: #0b0f0e;
    display: none;
}

.user-msg-row {
    width: 100%;
    height: auto;
    background: #0b0f0e;
    margin: 1 0 1 0;
    padding: 0;
}

.user-msg-rtl {
    text-align: right;
}

.ai-msg-block {
    width: 100%;
    height: auto;
    background: #0b0f0e;
    margin: 1 0 1 0;
    padding: 0;
}

.ai-meta-line {
    width: 100%;
    height: 1;
    color: #7f8b87;
    margin-bottom: 0;
}

.ai-reply-body {
    width: 100%;
    height: auto;
    background: #0b0f0e;
    color: #d7dedb;
    padding-left: 2;
    margin-top: 0;
}

.ai-reply-rtl {
    text-align: right;
    padding-right: 2;
}

.system-notice-line {
    width: 100%;
    height: auto;
    background: #0b0f0e;
    color: #e5b567;
    margin: 0 0 1 0;
    padding: 0;
}

/* ── Tool Call Item (1 collapsed line, expandable on Enter) ───────────────── */
.tool-call-block {
    width: 100%;
    height: auto;
    background: #0b0f0e;
    margin: 0 0 1 0;
    padding: 0 0 0 2;
}

.tool-call-header {
    width: 100%;
    height: 1;
    color: #7f8b87;
    background: #0b0f0e;
}

.tool-call-header:focus {
    color: #d7dedb;
    background: #121917;
}

.tool-call-details {
    width: 100%;
    height: auto;
    color: #7f8b87;
    background: #0e1412;
    border-left: solid #1b2421;
    padding: 0 2;
    margin-top: 0;
    display: none;
}

/* ── Bottom Dock in Chat View ─────────────────────────────────────────────── */
#bottom-dock {
    width: 100%;
    height: auto;
    background: #0b0f0e;
    border-top: solid #1b2421;
    padding: 0 2;
    display: none;
}

#input-row {
    width: 100%;
    min-height: 1;
    max-height: 6;
    height: auto;
    background: #0b0f0e;
    border: none;
    padding: 0;
    margin: 0;
}

#prompt-symbol {
    width: 2;
    height: 1;
    color: #5fd1a0;
    text-style: bold;
}

#prompt-input {
    width: 1fr;
    min-height: 1;
    max-height: 6;
    height: auto;
    background: #0b0f0e;
    border: none;
    color: #d7dedb;
    padding: 0;
}

#prompt-input:focus {
    border: none;
    background: #0b0f0e;
}

#slim-footer {
    width: 100%;
    height: 1;
    background: #0b0f0e;
    color: #7f8b87;
    margin-top: 0;
}

#footer-left {
    width: 1fr;
    height: 1;
    color: #7f8b87;
    content-align: left middle;
}

#footer-right {
    width: auto;
    height: 1;
    color: #7f8b87;
    content-align: right middle;
    text-align: right;
}

/* ── Clean Thin-Bordered Modals ───────────────────────────────────────────── */
ModalScreen {
    align: center middle;
    background: rgba(8, 11, 10, 0.85);
}

.modal-card {
    width: 80;
    height: auto;
    max-height: 88%;
    background: #0b0f0e;
    border: solid #1b2421;
    padding: 1 2;
}

.modal-title {
    width: 100%;
    color: #5fd1a0;
    text-style: bold;
    margin-bottom: 1;
}

.modal-subtitle {
    color: #7f8b87;
    margin-bottom: 1;
}

.modal-input {
    margin-bottom: 1;
    background: #111715;
    border: solid #1b2421;
    color: #d7dedb;
}

.modal-btn-row {
    width: 100%;
    height: auto;
    align: left middle;
    margin-top: 1;
}

.modal-btn-row Button {
    margin-right: 1;
    background: #111715;
    color: #d7dedb;
    border: solid #1b2421;
    min-width: 16;
    height: 3;
}

.modal-btn-row Button:hover, .modal-btn-row Button:focus {
    border: solid #5fd1a0;
    color: #5fd1a0;
    background: #121c18;
}

#diff-preview-box {
    height: 14;
    background: #0e1412;
    border: solid #1b2421;
    padding: 1;
    color: #d7dedb;
    overflow-y: auto;
}

OptionList {
    height: 12;
    background: #0e1412;
    border: solid #1b2421;
    margin-bottom: 1;
}
